# Illustrative 3.7V LiPo pouch, 30 x 40 x 6 mm, centred on origin, z from 0 to -6 mm (below the board). Units: 0.1 inch.
# foam pad between board and pouch: 26 x 36 x 2 mm, z 0 .. +2 (touches the board underside)
Transform {
  translation 0 0 0.394
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.22 0.22 0.24 } }
    geometry Box { size 10.236 14.173 0.787 }
  }
}
